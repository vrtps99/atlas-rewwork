getgenv().SrvHopUnload = function()
    IsRunning = false
    for idx = 1, #SignalConnections do
        if SignalConnections[idx] then pcall(function() SignalConnections[idx]:Disconnect() end) end
    end
    table.clear(SignalConnections)
    table.clear(ServerPool)
    table.clear(BlacklistTable)
    table.clear(PageCheckCache)
    BlacklistCount = 0
    if ScreenGui then ScreenGui:Destroy() end
end

local function SafeWrite(filePath, rawData)
    if not writefile then return end
    local isOk, encoded = pcall(HttpService.JSONEncode, HttpService, rawData)
    if isOk and encoded then
        writefile(filePath, encoded)
    end
end

local function SafeRead(filePath)
    if isfile and readfile and isfile(filePath) then
        local isOk, content = pcall(readfile, filePath)
        if isOk and content then
            local decOk, decData = pcall(HttpService.JSONDecode, HttpService, content)
            if decOk and type(decData) == "table" then return decData end
        end
    end
    return nil
end

-- Pool entries are tables { id, playing, max, cursor, t }. Old caches stored plain strings.
local function NormalizeEntry(entry)
    if type(entry) == "table" then return entry.id and entry or nil end
    if type(entry) == "string" then return { id = entry, t = 0 } end
    return nil
end

local function SavePersistentData(forceSave)
    local nowTime = workspace:GetServerTimeNow()
    if not forceSave and (nowTime - LastSaveTime < 10) then return end
    LastSaveTime = nowTime

    SafeWrite(CacheFile, ServerPool)
    SafeWrite(BlacklistFile, BlacklistTable)
    SafeWrite(StatsFile, {
        Cursor = NextCursor,
        Page = CurrentPage,
        Parsed = SessionStats.Parsed,
        Invalid = SessionStats.Invalid,
        Dead = SessionStats.Dead,
        RateLimits = SessionStats.RateLimits,
        Visited = SessionStats.Visited,
        LastJobId = SessionStats.LastJobId,
        PageParsedAt = PageParsedAt
    })
end

local function CleanBlacklist()
    local nowTime = workspace:GetServerTimeNow()
    for serverId, addedTime in pairs(BlacklistTable) do
        -- Never drop the current JobId from the blacklist while we are still on it
        if serverId ~= JobId and (nowTime - addedTime) > Config.PageExpireTime then
            BlacklistTable[serverId] = nil
            BlacklistCount = math.max(0, BlacklistCount - 1)
        end
    end
end

local function IsBlacklisted(serverId)
    if not serverId then return true end
    local addedTime = BlacklistTable[serverId]
    if not addedTime then return false end

    if serverId ~= JobId and (workspace:GetServerTimeNow() - addedTime) > Config.PageExpireTime then
        BlacklistTable[serverId] = nil
        BlacklistCount = math.max(0, BlacklistCount - 1)
        return false
    end
    return true
end

local function AddToBlacklist(serverId)
    if serverId and type(serverId) == "string" and #serverId > 0 then
        if not BlacklistTable[serverId] then
            BlacklistCount = BlacklistCount + 1
        end
        BlacklistTable[serverId] = workspace:GetServerTimeNow()
    end
end

local function ResetCycle()
    NextCursor, CurrentPage, PageParsedAt = "", 1, 0
    table.clear(ServerPool)
    table.clear(BlacklistTable)
    table.clear(PageCheckCache)
    BlacklistCount = 0
    SessionStats.Invalid, SessionStats.Dead, SessionStats.Parsed, SessionStats.Visited = 0, 0, 0, 1
    SessionStats.LastJobId = JobId

    -- Put the current server back into the blacklist after the table reset
    AddToBlacklist(JobId)

    if isfile and delfile then
        if isfile(CacheFile) then pcall(delfile, CacheFile) end
        if isfile(BlacklistFile) then pcall(delfile, BlacklistFile) end
        if isfile(StatsFile) then pcall(delfile, StatsFile) end
    end
end

local function UpdateUI(logMessage)
    if not IsRunning then return end

    if logMessage then LogLabel.Text = "> " .. tostring(logMessage) end

    CleanBlacklist()

    local timeRemainingText = "N/A"
    if PageParsedAt > 0 then
        local remainingSec = math.max(0, math.floor(Config.PageExpireTime - (workspace:GetServerTimeNow() - PageParsedAt)))
        timeRemainingText = string.format("%02d:%02d", math.floor(remainingSec / 60), remainingSec % 60)
    end

    StatsLabel.Text = string.format("Visited: %d\nParsed: %d\nValid Queue: %d\nInvalid: %d\nDead/full skipped: %d\nBlacklisted: %d\nRateLimits: %d\nCurrent Page: %d\nPage Expire in: %s",
        SessionStats.Visited, SessionStats.Parsed, #ServerPool, SessionStats.Invalid, SessionStats.Dead, BlacklistCount, SessionStats.RateLimits, CurrentPage, timeRemainingText)
end

local function CleanQueueFromBlacklist()
    for idx = #ServerPool, 1, -1 do
        local serverEntry = NormalizeEntry(ServerPool[idx])
        local serverId = serverEntry and serverEntry.id
        if not serverId or serverId == JobId or IsBlacklisted(serverId) then
            table.remove(ServerPool, idx)
        else
            ServerPool[idx] = serverEntry
        end
    end
end

local function LoadPersistentData()
    local loadedBlacklist = SafeRead(BlacklistFile)
    if loadedBlacklist then
        BlacklistTable = loadedBlacklist
        BlacklistCount = 0
        for _ in pairs(BlacklistTable) do
            BlacklistCount = BlacklistCount + 1
        end
    end

    local loadedStats = SafeRead(StatsFile)
    if loadedStats then
        NextCursor = loadedStats.Cursor or ""
        CurrentPage = loadedStats.Page or 1
        SessionStats.Parsed = loadedStats.Parsed or 0
        SessionStats.Invalid = loadedStats.Invalid or 0
        SessionStats.Dead = loadedStats.Dead or 0
        SessionStats.Visited = loadedStats.Visited or 0
        SessionStats.RateLimits = loadedStats.RateLimits or 0
        SessionStats.LastJobId = loadedStats.LastJobId or ""
        PageParsedAt = loadedStats.PageParsedAt or 0
    end

    local loadedCache = SafeRead(CacheFile)
    local hasCache = false

    if loadedCache and #loadedCache > 0 then
        ServerPool = loadedCache
        hasCache = true
    end

    if SessionStats.LastJobId ~= JobId then
        SessionStats.Visited = SessionStats.Visited + 1
        SessionStats.LastJobId = JobId
    end

    AddToBlacklist(JobId)
    CleanBlacklist()
    CleanQueueFromBlacklist()

    UpdateUI(hasCache and ("Cache restored. Queue: " .. #ServerPool) or "No cache found.")
    return hasCache
end

-- Requests one page of the public server list. Returns the decoded table or nil on failure.
local function RequestPage(cursor)
    cursor = cursor or ""
    local apiUrl = string.format("https://games.roblox.com/v1/games/%d/servers/Public?sortOrder=Asc&limit=100%s", PlaceId, (cursor ~= "" and "&cursor=" .. cursor or ""))
    LastApiCall = workspace:GetServerTimeNow()

    local reqSuccess, httpResponse = pcall(game.HttpGet, game, apiUrl)
    if not reqSuccess or type(httpResponse) ~= "string" or not httpResponse:find("^{") then
        return nil
    end

    local decodeSuccess, parsedData = pcall(HttpService.JSONDecode, HttpService, httpResponse)
    if not decodeSuccess or type(parsedData) ~= "table" or not parsedData.data then
        return nil
    end
    return parsedData
end

-- Checks that a queued server is still alive and has a free slot.
-- Re-reads the page the server came from (once per FreshTime per page) and looks for the server in it.
-- If the page cannot be re-read (rate limit etc.) the server is treated as "unknown" and we still try it;
-- TeleportInitFailed will blacklist it if it is really dead.
local function ValidateEntry(entry)
    if not Config.CheckAlive or entry.cursor == nil then return true end

    local now = workspace:GetServerTimeNow()
    if entry.t and (now - entry.t) < Config.FreshTime then return true end

    local cache = PageCheckCache[entry.cursor]
    if not cache or (now - cache.time) > Config.FreshTime then
        local waitTime = Config.ApiCooldown - (now - LastApiCall)
        if waitTime > 0 then task.wait(waitTime) end
        if not IsRunning then return false end

        UpdateUI("Checking if server is alive...")
        local data = RequestPage(entry.cursor)
        if not data then
            SessionStats.RateLimits = SessionStats.RateLimits + 1
            return true
        end

        local live = {}
        for idx = 1, #data.data do
            local serverObj = data.data[idx]
            if serverObj.id then live[serverObj.id] = serverObj end
        end
        cache = { time = workspace:GetServerTimeNow(), live = live }
        PageCheckCache[entry.cursor] = cache
    end

    local serverObj = cache.live[entry.id]
    if not serverObj then return false end -- server is gone
    if serverObj.playing and serverObj.maxPlayers and serverObj.playing >= serverObj.maxPlayers then
        return false -- server is full
    end

    entry.t = cache.time
    return true
end

local function FetchPage()
    while not getgenv().SrvHop and IsRunning do task.wait(0.5) end
    if not IsRunning then return false end

    UpdateUI("Fetching API (Page " .. CurrentPage .. ")...")
    local pageCursor = NextCursor
    local parsedData = RequestPage(pageCursor)

    if not parsedData then
        SessionStats.RateLimits = SessionStats.RateLimits + 1
        UpdateUI("Rate limited / API error.")
        SavePersistentData(false)
        task.wait(5)
        return false
    end

    NextCursor = parsedData.nextPageCursor or ""
    local addedCount = 0
    PageParsedAt = workspace:GetServerTimeNow()

    for idx = 1, #parsedData.data do
        local serverObj = parsedData.data[idx]
        local serverId = serverObj.id
        local isFull = serverObj.playing and serverObj.maxPlayers and serverObj.playing >= serverObj.maxPlayers
        if serverId and serverId ~= JobId and not isFull and not IsBlacklisted(serverId) then
            SessionStats.Parsed = SessionStats.Parsed + 1
            table.insert(ServerPool, {
                id = serverId,
                playing = serverObj.playing,
                max = serverObj.maxPlayers,
                cursor = pageCursor,
                t = PageParsedAt
            })
            addedCount = addedCount + 1
        end
    end

    parsedData = nil

    SavePersistentData(true)
    UpdateUI("Page " .. CurrentPage .. " parsed. Added: " .. addedCount)
    return true
end

local function ProcessCurrentPool()
    while IsRunning and #ServerPool > 0 do
        while not getgenv().SrvHop and IsRunning do task.wait(0.5) end
        if not IsRunning then break end

        if PageParsedAt > 0 and (workspace:GetServerTimeNow() - PageParsedAt) > Config.PageExpireTime then
            UpdateUI("Page expired (>1h). Resetting cache & stats...")
            ResetCycle()
            SavePersistentData(true)
            break
        end

        local targetEntry = NormalizeEntry(table.remove(ServerPool, 1))
        local targetId = targetEntry and targetEntry.id

        if targetId and not IsBlacklisted(targetId) and targetId ~= JobId then
            if ValidateEntry(targetEntry) then
                if not IsRunning then break end
                if not getgenv().SrvHop then
                    -- hopping was paused while we were checking; keep the server for later
                    table.insert(ServerPool, 1, targetEntry)
                else
                    PendingTargetId = targetId
                    SavePersistentData(true)
                    UpdateUI(string.format("TP to %s...", targetId:sub(1, 8)))

                    pcall(TeleportService.TeleportToPlaceInstance, TeleportService, PlaceId, targetId, LocalPlayer)
                    task.wait(Config.TeleportCooldown)
                end
            else
                AddToBlacklist(targetId)
                SessionStats.Dead = SessionStats.Dead + 1
                SavePersistentData(true)
                UpdateUI(string.format("Server %s is dead/full, skipped.", targetId:sub(1, 8)))
            end
        else
            UpdateUI("Skipped blacklisted server.")
        end
    end
end

table.insert(SignalConnections, TeleportService.TeleportInitFailed:Connect(function(playerObj, teleportResult, errorMessage)
    if playerObj == LocalPlayer and IsRunning then
        SessionStats.Invalid = SessionStats.Invalid + 1
        if PendingTargetId then
            AddToBlacklist(PendingTargetId)
            PendingTargetId = nil
        elseif type(errorMessage) == "string" then
            local failedId = errorMessage:match("%w+-%w+-%w+-%w+-%w+")
            if failedId then AddToBlacklist(failedId) end
        end
        SavePersistentData(true)
        UpdateUI("TP Failed: " .. tostring(teleportResult.Name))
    end
end))

getgenv().SrvHopThread = task.spawn(function()
    local hasRestoredCache = LoadPersistentData()
    SavePersistentData(true)

    if hasRestoredCache and #ServerPool > 0 then
        if PageParsedAt > 0 and (workspace:GetServerTimeNow() - PageParsedAt) > Config.PageExpireTime then
            UpdateUI("Restored page expired (>1h). Resetting...")
            ResetCycle()
            SavePersistentData(true)
        else
            ProcessCurrentPool()
        end
    end

    while IsRunning do
        while not getgenv().SrvHop and IsRunning do task.wait(0.5) end

        if #ServerPool == 0 then
            if SessionStats.Parsed == 0 and CurrentPage == 1 and NextCursor == "" then
                if FetchPage() and #ServerPool > 0 then
                    ProcessCurrentPool()
                end

            elseif NextCursor ~= "" then
                CurrentPage = CurrentPage + 1
                task.wait(Config.ApiCooldown)
                if FetchPage() and #ServerPool > 0 then
                    ProcessCurrentPool()
                end

            else
                UpdateUI("Full cycle complete. Resetting to Page 1...")
                ResetCycle()
                SavePersistentData(true)
                task.wait(Config.ApiCooldown)
                FetchPage()
            end
        else
            ProcessCurrentPool()
            task.wait(0.1)
        end
    end
end)
